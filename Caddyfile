{
	admin off
	auto_https off
	persist_config off
	log {
		level WARN
	}
}

:{$PORT} {
	# Railway's health check: no login, answered by Vibe Kanban itself.
	handle /healthz {
		rewrite * /api/health
		reverse_proxy 127.0.0.1:{$VK_INTERNAL_PORT}
	}

	# Everything else needs the generated login (Vibe Kanban has none of its own).
	handle {
		basic_auth {
			{$VIBE_KANBAN_USERNAME} {$VK_PASSWORD_HASH}
		}
		reverse_proxy 127.0.0.1:{$VK_INTERNAL_PORT} {
			flush_interval -1
		}
	}
}
